# =============================================================================
# NovaWallet API — Environment Template
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up -d` from the novawallet-api/ directory.
#
# All of these are REQUIRED — the stack fails fast at startup if missing.
# =============================================================================

# Database password (used for both the PostgreSQL container and the API)
DB_PASSWORD=

# Base64-encoded 256+ bit secret for JWT signing (generate: openssl rand -base64 64)
JWT_SECRET=

# Admin seed account (created on first boot only)
APP_ADMIN_EMAIL=admin@novawallet.com
APP_ADMIN_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────
# Africa's Talking API key (empty = SMS stub mode)
# APP_SMS_API_KEY=

# Comma-separated allowed CORS origins
# APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173