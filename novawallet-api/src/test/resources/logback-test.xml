<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only logback configuration. Console-only so tests can run without a
     /var/log/novawallet directory. Production keeps its own logback-spring.xml
     (FILE appender) untouched. -->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{requestId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Silence noisy frameworks during tests -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="ERROR"/>
    <logger name="org.flywaydb" level="ERROR"/>

</configuration>
